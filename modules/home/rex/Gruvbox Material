# Gruvbox Material — Rex terminal theme (Ghostty palette format).
# Mirrors the helix "custom-cat" theme (modules/home/helix/catppuccin.nix),
# which is catppuccin's structure filled with gruvbox-material hard colours.
# Import once via Rex: Settings > Themes > Import Theme (or
# `rex do client.theme.import path=...`). Rex copies it into its own
# preferences, so re-import after editing this file.

background = #1d2021
foreground = #ebdbb2

# helix ui.cursor (lavender)
cursor-color = #7daea3
cursor-text = #1d2021

# helix ui.selection.primary (surface1)
selection-background = #404040
selection-foreground = #ebdbb2

# color0 is surface1 so "black" text stays visible on #1d2021
palette = 0=#404040
palette = 1=#ea6962
palette = 2=#a9b665
palette = 3=#d8a657
palette = 4=#7daea3
palette = 5=#d3869b
