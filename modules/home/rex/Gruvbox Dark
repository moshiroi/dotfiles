# Gruvbox Dark (hard) — Rex terminal theme (Ghostty palette format).
# The original Gruvbox colours at full saturation, the same as Ghostty's
# (`gruvbox` in modules/theme/palette.nix): normal colours are the deep set
# (red #cc241d), bright colours the vivid set (red #fb4934). Claude Code's
# "dark-ansi" theme draws its logo and accents from these slots, so they
# follow this file.
# Import via Rex: Settings > Themes > Import Theme (or
# `rex do client.theme.import path=...`). Rex copies it into its own
# preferences, so re-import after editing this file.

background = #1d2021
foreground = #ebdbb2

cursor-color = #83a598
cursor-text = #1d2021

selection-background = #504945
selection-foreground = #ebdbb2

# color0 is Gruvbox bg1, not the background, so "black" text stays visible
palette = 0=#3c3836
palette = 1=#cc241d
palette = 2=#98971a
palette = 3=#d79921
palette = 4=#458588
palette = 5=#b16286
palette = 6=#689d6a
palette = 7=#a89984
palette = 8=#928374
palette = 9=#fb4934
palette = 10=#b8bb26
palette = 11=#fabd2f
palette = 12=#83a598
palette = 13=#d3869b
palette = 14=#8ec07c
palette = 15=#ebdbb2
