{
  "document": { "block_prefix": "\n", "block_suffix": "\n", "color": "#ebdbb2", "margin": 1 },
  "block_quote": { "indent": 1, "indent_token": "▎ ", "color": "#d4be98" },
  "paragraph": {},
  "list": { "level_indent": 2 },

  "heading": { "block_suffix": "\n", "color": "#d8a657", "bold": true },
  "h1": { "prefix": " ", "suffix": " ", "color": "#1d2021", "background_color": "#d8a657", "bold": true },
  "h2": { "prefix": "▍", "color": "#e78a4e", "bold": true },
  "h3": { "prefix": "  ", "color": "#a9b665", "bold": true },
  "h4": { "prefix": "  ", "color": "#89b482" },
  "h5": { "prefix": "  ", "color": "#7daea3" },
  "h6": { "prefix": "  ", "color": "#928374" },

  "text": {},
  "strikethrough": { "crossed_out": true },
  "emph": { "italic": true, "color": "#d4be98" },
  "strong": { "bold": true, "color": "#fbf1c7" },
  "hr": { "color": "#504945", "format": "\n──────────────────────────────\n" },

  "item": { "block_prefix": "• " },
  "enumeration": { "block_prefix": ". ", "color": "#d8a657" },
  "task": { "ticked": "[✓] ", "unticked": "[ ] " },

  "link": { "color": "#7daea3", "underline": true },
  "link_text": { "color": "#89b482", "bold": true },
  "image": { "color": "#7daea3", "underline": true },
  "image_text": { "color": "#928374", "format": "image: {{.text}} →" },

  "code": { "prefix": " ", "suffix": " ", "color": "#e78a4e", "background_color": "#32302f" },
  "code_block": {
    "color": "#d4be98",
    "margin": 2,
    "chroma": {
      "text": { "color": "#d4be98" },
      "error": { "color": "#ea6962" },
      "comment": { "color": "#928374", "italic": true },
      "comment_preproc": { "color": "#e78a4e" },
      "keyword": { "color": "#ea6962" },
      "keyword_reserved": { "color": "#ea6962" },
      "keyword_namespace": { "color": "#ea6962" },
      "keyword_type": { "color": "#d8a657" },
      "operator": { "color": "#e78a4e" },
      "punctuation": { "color": "#a89984" },
      "name": { "color": "#d4be98" },
      "name_builtin": { "color": "#d3869b" },
      "name_tag": { "color": "#e78a4e" },
      "name_attribute": { "color": "#a9b665" },
      "name_class": { "color": "#d8a657" },
      "name_constant": { "color": "#d3869b" },
      "name_decorator": { "color": "#89b482" },
      "name_function": { "color": "#a9b665" },
      "name_other": { "color": "#7daea3" },
      "literal": { "color": "#d3869b" },
      "literal_number": { "color": "#d3869b" },
      "literal_date": { "color": "#d3869b" },
      "literal_string": { "color": "#a9b665" },
      "literal_string_escape": { "color": "#e78a4e" },
      "generic_deleted": { "color": "#ea6962" },
      "generic_emph": { "italic": true },
      "generic_inserted": { "color": "#a9b665" },
      "generic_strong": { "bold": true },
      "generic_subheading": { "color": "#7daea3" },
      "background": { "background_color": "#282828" }
    }
  },

  "table": { "color": "#ebdbb2", "center_separator": "┼", "column_separator": "│", "row_separator": "─" },
  "definition_list": {},
  "definition_term": { "color": "#d8a657" },
  "definition_description": { "block_prefix": "\n  " },
  "html_block": {},
  "html_span": {}
}
